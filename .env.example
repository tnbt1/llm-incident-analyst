# 設定の上書き（.env の雛形）。`tia config env-template` が作る。
#
# すべての設定は環境変数で上書きできる。項目 `節.キー` の変数名は `TIA_節_キー` の大文字。
# 優先は 環境変数 > .env > analyzer.yaml > 既定。
# .env の場所は、TIA_ENV_FILE があればその場所、なければ analyzer.yaml と同じフォルダの .env。
# Compose では compose.yaml の env_file がこのファイルをコンテナに渡す。TIA_IMAGE_TAG は Compose 自身が読む。
# 変えたい行の先頭の # を外す。値の引用符は要らない。並びはコンマ区切り。
# 現在の値と由来は `tia config show --config <analyzer.yaml>` で見る。

## knowledge
# knowledge.source_dir: 管理 PC で束を作るときの出典（文字列、既定 examples/knowledge-source）
#TIA_KNOWLEDGE_SOURCE_DIR=examples/knowledge-source
# knowledge.bundle_dir: 束の置き場所（文字列、既定 config/knowledge）
#TIA_KNOWLEDGE_BUNDLE_DIR=config/knowledge
# knowledge.recipe: 束の作り方（文字列、既定 config/knowledge.yaml）
#TIA_KNOWLEDGE_RECIPE=config/knowledge.yaml
# knowledge.mode: selection = 該当節を選ぶ、full = 全文を先頭に置く（selection か full、既定 selection）
#TIA_KNOWLEDGE_MODE=selection
# knowledge.card_budget_tokens: knowledge.card_budget_tokens（整数 1〜131072、既定 6000）
#TIA_KNOWLEDGE_CARD_BUDGET_TOKENS=6000
# knowledge.section_budget_tokens: knowledge.section_budget_tokens（整数 0〜131072、既定 3000）
#TIA_KNOWLEDGE_SECTION_BUDGET_TOKENS=3000
# knowledge.max_sections: knowledge.max_sections（整数 0〜20、既定 3）
#TIA_KNOWLEDGE_MAX_SECTIONS=3
# knowledge.stale_after_days: knowledge.stale_after_days（整数 1〜3650、既定 30）
#TIA_KNOWLEDGE_STALE_AFTER_DAYS=30
# knowledge.reload_check_sec: 束の入れ替えを確かめる間隔（整数 5〜3600、既定 60）
#TIA_KNOWLEDGE_RELOAD_CHECK_SEC=60

## zabbix
# zabbix.min_severity: 2 = Warning（整数 0〜5、既定 2）
#TIA_ZABBIX_MIN_SEVERITY=2
# zabbix.hold_sec: 束ね判定の待ち（整数 0〜3600、既定 60）
#TIA_ZABBIX_HOLD_SEC=60
# zabbix.fetch_min_severity: 1 = Information。これ以上を取得し、min_severity 未満は対象外として残す。書かなければ 1 と min_severity の小さい方（整数 0〜5、空なら 1 と zabbix.min_severity の小さい方、既定 空）
#TIA_ZABBIX_FETCH_MIN_SEVERITY=
# zabbix.poll_interval_sec: zabbix.poll_interval_sec（整数 5〜3600、既定 30）
#TIA_ZABBIX_POLL_INTERVAL_SEC=30
# zabbix.page_size: 1 回の要求で受け取る件数（整数 1〜1000、既定 200）
#TIA_ZABBIX_PAGE_SIZE=200
# zabbix.max_pages: 1 回の収集で読むページ数（整数 1〜100、既定 10）
#TIA_ZABBIX_MAX_PAGES=10

## wazuh
# wazuh.min_level: wazuh.min_level（整数 0〜16、既定 10）
#TIA_WAZUH_MIN_LEVEL=10
# wazuh.named_rules: wazuh.named_rules（文字列の並び、コンマ区切り、既定 100101,5402,550,553,554,5710,5712,5716,5720,5901,5902）
#TIA_WAZUH_NAMED_RULES=100101,5402,550,553,554,5710,5712,5716,5720,5901,5902
# wazuh.hold_sec: wazuh.hold_sec（整数 0〜3600、既定 120）
#TIA_WAZUH_HOLD_SEC=120
# wazuh.poll_interval_sec: wazuh.poll_interval_sec（整数 5〜3600、既定 60）
#TIA_WAZUH_POLL_INTERVAL_SEC=60
# wazuh.page_size: wazuh.page_size（整数 1〜1000、既定 200）
#TIA_WAZUH_PAGE_SIZE=200
# wazuh.max_pages: wazuh.max_pages（整数 1〜100、既定 10）
#TIA_WAZUH_MAX_PAGES=10
# wazuh.tiebreak_field: 同じ時刻のアラートの順序を決める項目（文字列、既定 id）
#TIA_WAZUH_TIEBREAK_FIELD=id

## intake
# intake.recurrence_window_sec: intake.recurrence_window_sec（整数 1〜86400、既定 1800）
#TIA_INTAKE_RECURRENCE_WINDOW_SEC=1800
# intake.followup_after_sec: intake.followup_after_sec（整数 1〜604800、既定 7200）
#TIA_INTAKE_FOLLOWUP_AFTER_SEC=7200
# intake.skip_resolved_after_sec: intake.skip_resolved_after_sec（整数 1〜2592000、既定 21600）
#TIA_INTAKE_SKIP_RESOLVED_AFTER_SEC=21600

## grouping
# grouping.storm_count: grouping.storm_count（整数 2〜1000、既定 5）
#TIA_GROUPING_STORM_COUNT=5
# grouping.storm_window_sec: grouping.storm_window_sec（整数 1〜86400、既定 300）
#TIA_GROUPING_STORM_WINDOW_SEC=300
# grouping.root_host: grouping.root_host（文字列、既定 example-router01）
#TIA_GROUPING_ROOT_HOST=example-router01

## queue
# queue.retry_delays_sec: queue.retry_delays_sec（整数の並び、コンマ区切り、各 1〜86400、既定 60,300,900）
#TIA_QUEUE_RETRY_DELAYS_SEC=60,300,900

## collector
# collector.tick_sec: 整理と、収集の時刻の確認の間隔（整数 1〜60、既定 5）
#TIA_COLLECTOR_TICK_SEC=5
# collector.first_lookback_sec: 初回にさかのぼる長さ（整数 0〜604800、既定 3600）
#TIA_COLLECTOR_FIRST_LOOKBACK_SEC=3600
# collector.overlap_sec: 前回位置から重ねて読む長さ。検索に遅れて現れるアラートを拾う（整数 10〜3600、既定 120）
#TIA_COLLECTOR_OVERLAP_SEC=120
# collector.connect_timeout_sec: collector.connect_timeout_sec（整数 1〜60、既定 5）
#TIA_COLLECTOR_CONNECT_TIMEOUT_SEC=5
# collector.timeout_sec: collector.timeout_sec（整数 1〜120、既定 10）
#TIA_COLLECTOR_TIMEOUT_SEC=10
# collector.backoff_max_sec: 失敗が続いたときの待ちの上限（整数 5〜86400、既定 600）
#TIA_COLLECTOR_BACKOFF_MAX_SEC=600
# collector.auth_backoff_sec: 認証に失敗したときの待ち（整数 5〜86400、既定 900）
#TIA_COLLECTOR_AUTH_BACKOFF_SEC=900
# collector.max_response_mb: 1 回の応答の大きさの上限（整数 1〜256、既定 16）
#TIA_COLLECTOR_MAX_RESPONSE_MB=16

## llm
# llm.model: 要求の model。TIA_LLM_MODEL で上書きできる（文字列、既定 example/model-27b）
#TIA_LLM_MODEL=example/model-27b
# llm.temperature: llm.temperature（数 0.0〜2.0、既定 0.2）
#TIA_LLM_TEMPERATURE=0.2
# llm.retry_temperature: 検証に失敗して作り直すときの値（数 0.0〜2.0、既定 0.0）
#TIA_LLM_RETRY_TEMPERATURE=0.0
# llm.max_tokens: llm.max_tokens（整数 1〜32768、既定 1200）
#TIA_LLM_MAX_TOKENS=1200
# llm.timeout_sec: 1 回の要求の全体。Open WebUI の上流への待ち(300 秒)より短くする（整数 1〜299、既定 240）
#TIA_LLM_TIMEOUT_SEC=240
# llm.connect_timeout_sec: llm.connect_timeout_sec（整数 1〜60、既定 5）
#TIA_LLM_CONNECT_TIMEOUT_SEC=5
# llm.max_response_mb: llm.max_response_mb（整数 1〜64、既定 4）
#TIA_LLM_MAX_RESPONSE_MB=4
# llm.thinking: 要求ごとに enable_thinking を指定する。サーバーの既定は変えない（真偽 true/false、既定 false）
#TIA_LLM_THINKING=false
# llm.allow_other_route: 宛先は Open WebUI の中継経路（URL の末尾が /openai）。別の経路を使うときだけ true（真偽 true/false、既定 false）
#TIA_LLM_ALLOW_OTHER_ROUTE=false
# llm.context_tokens: llama-server の文脈長。入力の上限と出力の上限の合計がこれを超えない（整数 4096〜1048576、既定 131072）
#TIA_LLM_CONTEXT_TOKENS=131072

## context
# context.input_budget_tokens: context.input_budget_tokens（整数 1000〜1048576、既定 15600）
#TIA_CONTEXT_INPUT_BUDGET_TOKENS=15600
# context.rules_budget_tokens: context.rules_budget_tokens（整数 100〜10000、既定 500）
#TIA_CONTEXT_RULES_BUDGET_TOKENS=500
# context.cases_budget_tokens: context.cases_budget_tokens（整数 0〜100000、既定 900）
#TIA_CONTEXT_CASES_BUDGET_TOKENS=900
# context.cases_max: context.cases_max（整数 0〜10、既定 3）
#TIA_CONTEXT_CASES_MAX=3
# context.stats_budget_tokens: context.stats_budget_tokens（整数 0〜10000、既定 200）
#TIA_CONTEXT_STATS_BUDGET_TOKENS=200
# context.dynamic_budget_tokens: アラート、経過、確認の結果（整数 200〜100000、既定 5000）
#TIA_CONTEXT_DYNAMIC_BUDGET_TOKENS=5000
# context.history_days: 同じホストの最近のインシデントをさかのぼる日数（整数 1〜365、既定 7）
#TIA_CONTEXT_HISTORY_DAYS=7
# context.history_max: context.history_max（整数 0〜100、既定 10）
#TIA_CONTEXT_HISTORY_MAX=10
# context.stats_window_days: 同じ指紋の過去の回数と復旧の統計をさかのぼる日数（整数 1〜3650、既定 30）
#TIA_CONTEXT_STATS_WINDOW_DAYS=30
# context.token_margin_percent: 見積もりの誤差の分だけ、上限より手前で止める（整数 0〜50、既定 10）
#TIA_CONTEXT_TOKEN_MARGIN_PERCENT=10

## web
# web.host: コンテナの中の待受。外には Caddy だけが公開する（文字列、既定 0.0.0.0）
#TIA_WEB_HOST=0.0.0.0
# web.port: web.port（整数 1〜65535、既定 8000）
#TIA_WEB_PORT=8000
# web.system_name: 画面の左上と <title> に出す名前（文字列、既定 Incident Analyst）
#TIA_WEB_SYSTEM_NAME=Incident Analyst
# web.timezone: 画面に表示する時刻の時間帯（文字列、既定 Asia/Tokyo）
#TIA_WEB_TIMEZONE=Asia/Tokyo
# web.sse_poll_sec: 変化を見に行く間隔（整数 1〜30、既定 1）
#TIA_WEB_SSE_POLL_SEC=1
# web.sse_max_sec: 1 本の接続を閉じてつなぎ直させるまでの秒数（整数 2〜86400、既定 600）
#TIA_WEB_SSE_MAX_SEC=600
# web.health_interval_sec: LLM と知識の束を確かめる間隔（整数 5〜3600、既定 30）
#TIA_WEB_HEALTH_INTERVAL_SEC=30
# web.stall_warn_sec: 待ちがこれを超えたら最上段に警告を出す（整数 60〜86400、既定 600）
#TIA_WEB_STALL_WARN_SEC=600
# web.max_rows: 一覧に出す行の上限（整数 10〜5000、既定 500）
#TIA_WEB_MAX_ROWS=500
# web.min_free_mb: 保存先の空きがこれを下回ったら異常にする（整数 1〜1000000、既定 200）
#TIA_WEB_MIN_FREE_MB=200
# web.cookie_secure: Cookie を https でだけ送る（真偽 true/false、既定 true）
#TIA_WEB_COOKIE_SECURE=true

## worker
# worker.idle_sec: 待ちが空のときに次を見るまでの間隔（整数 1〜60、既定 2）
#TIA_WORKER_IDLE_SEC=2
# worker.progress_every_chunks: 受け取った断片が何個増えるごとに進捗を保存するか（整数 1〜1000、既定 25）
#TIA_WORKER_PROGRESS_EVERY_CHUNKS=25
# worker.backoff_min_sec: LLM に届かない、断られる、相手の誤りのときの最初の待ち。倍々で延びる（整数 1〜3600、既定 5）
#TIA_WORKER_BACKOFF_MIN_SEC=5
# worker.backoff_max_sec: 待ちの上限（整数 1〜86400、既定 600）
#TIA_WORKER_BACKOFF_MAX_SEC=600
# worker.auth_backoff_sec: 認証の誤り（鍵の間違い）のときの待ち（整数 1〜86400、既定 900）
#TIA_WORKER_AUTH_BACKOFF_SEC=900
# worker.enabled: 解析のワーカーを動かすか。段階 2（収集だけ）では false（真偽 true/false、既定 true）
#TIA_WORKER_ENABLED=true

## retention
# retention.incident_days: インシデント、解析、経過を残す日数（整数 1〜3650、既定 180）
#TIA_RETENTION_INCIDENT_DAYS=180
# retention.payload_days: 元アラートの本文と、渡した文脈を残す日数（整数 1〜3650、既定 90）
#TIA_RETENTION_PAYLOAD_DAYS=90
# retention.skipped_days: 対象外を残す日数（整数 1〜3650、既定 14）
#TIA_RETENTION_SKIPPED_DAYS=14

## backup
# backup.dir: 世代ごとのフォルダを作る場所。コンテナでは /backups（文字列、既定 backups）
#TIA_BACKUP_DIR=backups
# backup.keep: 残す世代の数（整数 1〜365、既定 7）
#TIA_BACKUP_KEEP=7
# backup.at: 取る時刻。web.timezone の時計。引用符で囲む（HH:MM、既定 04:30）
#TIA_BACKUP_AT=04:30

## housekeeping
# housekeeping.retention_at: 保持期間の整理の時刻（HH:MM、既定 04:40）
#TIA_HOUSEKEEPING_RETENTION_AT=04:40

## probes
# probes.enabled: 推論の前に、読み取りだけの確認を VM・Zabbix・Wazuh に行う。鍵がなければ警告して無効（真偽 true/false、既定 true）
#TIA_PROBES_ENABLED=true
# probes.total_budget_sec: 1 回の解析で確認に使う時間の全体（整数 5〜120、既定 30）
#TIA_PROBES_TOTAL_BUDGET_SEC=30
# probes.timeout_sec: 確認 1 件の上限。カタログの値がこれより小さければそちら（整数 1〜30、既定 10）
#TIA_PROBES_TIMEOUT_SEC=10
# probes.output_cap_bytes: 確認 1 件の出力の上限。カタログの値がこれより小さければそちら（整数 512〜65536、既定 4096）
#TIA_PROBES_OUTPUT_CAP_BYTES=4096
# probes.ssh_user: VM 側の確認専用の利用者（文字列、既定 analyst-probe）
#TIA_PROBES_SSH_USER=analyst-probe
# probes.catalog: probes.catalog（文字列、既定 config/probes.yaml）
#TIA_PROBES_CATALOG=config/probes.yaml
# probes.known_hosts: 確認対象の VM のホスト鍵（ssh-keyscan の出力）（文字列、既定 config/probes_known_hosts）
#TIA_PROBES_KNOWN_HOSTS=config/probes_known_hosts
# probes.key_file: 秘密鍵。コンテナには secrets で渡す（文字列、既定 /run/secrets/probe_ssh_key）
#TIA_PROBES_KEY_FILE=/run/secrets/probe_ssh_key

## 接続先、秘密のファイルの場所、Compose
# Zabbix の API の URL。書かなければ Zabbix からは収集しない
#TIA_ZABBIX_URL=
# Zabbix の API トークンのファイル。既定 /run/secrets/zabbix_api_token
#TIA_ZABBIX_TOKEN_FILE=
# Wazuh のインデクサーの URL（https）。書かなければ Wazuh からは収集しない
#TIA_WAZUH_URL=
# インデクサーの利用者名。既定 analyzer_ro
#TIA_WAZUH_USER=
# インデクサーのパスワードのファイル。既定 /run/secrets/wazuh_indexer_password
#TIA_WAZUH_PASSWORD_FILE=
# インデクサーの証明書を確かめる CA のファイル
#TIA_WAZUH_CA_FILE=
# LLM の URL。Open WebUI の中継経路（末尾が /openai）
#TIA_LLM_URL=
# LLM の API 鍵のファイル。既定 /run/secrets/openwebui_api_key
#TIA_LLM_API_KEY_FILE=
# 確認に使う ssh の実行ファイル。試験のための差し替え
#TIA_PROBE_SSH_BIN=
# Compose が起動する画像の版。この .env を Compose 自身も読む
#TIA_IMAGE_TAG=
